# MongoDB connection string. In docker-compose, use the service hostname `mongo`.
MONGODB_URI=mongodb://mongo:27017/taskflow

# Secret used to sign/verify JWT access tokens. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# NextAuth / session secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# Public base URL of the app. Used by NextAuth and absolute callbacks.
NEXTAUTH_URL=http://localhost:3000
